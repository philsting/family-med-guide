---
import { getCollection } from 'astro:content';
import Layout from '../layouts/GuideLayout.astro';
import Notice from '../components/Notice.astro';
const guides = (await getCollection('guides')).sort((a,b) => a.data.order-b.data.order);
const confirmed = (await getCollection('locations')).filter(item => item.data.status === '已电话确认').length;
const base = import.meta.env.BASE_URL;
---
<Layout title="家人的事，一件件办">
  <section class="hero">
    <p class="eyebrow">家庭医疗信息指南</p>
    <h1>家人的事，<br />一件件办。</h1>
    <p class="lead">买药去哪里、注射怎么问、医保怎么办。<br />选一张卡片，查看下一步。</p>
  </section>
  <div class="grid">
    {guides.map((guide,index) => (
      <a class="nav-card" href={`${base}${guide.id}/`}>
        <span class="number">0{index+1} / 查看指南 →</span>
        <strong>{guide.data.title}</strong>
        <p>{guide.data.description}</p>
      </a>
    ))}
  </div>
  <Notice title="第一次注射，先电话确认">
    {confirmed === 0 ? '目前没有已确认的注射机构。' : '请查看各机构的确认日期和接收条件，出发前再次联系。'}
    候选方向不代表可注射，请先问清是否接收外院处方和自带药。
  </Notice>
  <p class="meta">公开信息整理：2026-09-29 · 不记录个人病情或治疗数据</p>
</Layout>
